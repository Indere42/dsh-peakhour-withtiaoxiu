{
  "name": "dsh-peakhour-withtiaoxiu",
  "version": "0.1.0",
  "description": "DeepSeek API peak/off-peak billing clock for the DSH Web GUI — 调休-aware, with an on-demand/scheduled policy sync from the official pricing page",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "peak-hour",
    "off-peak",
    "tiaoxiu",
    "pricing"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/wrap-client.cjs",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PLACEHOLDER/dsh-peakhour-withtiaoxiu.git"
  }
}
